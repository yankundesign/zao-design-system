  {
    "title": "Hairline figures, Lucas Marques",
    "sourceUrl": "https://hairline.lucasmarkes.com/figures",
    "tags": ["user-reference", "clarity", "linework", "neutral"],
    "boards": ["su-quiet-instrument"],
    "notes": "Added at Yankun's request on 2026-10-06 for the clarity of the figures page. Quiet instrument's base palette is now achromatic in both modes; further stroke and component refinement remains open.",
    "likes": "Generous open space; precise fine linework; contrast that keeps the subject distinct from supporting detail; geometry explained through interaction.",
    "dislikes": "",
    "teardown": {
      "neutralTemperature": "Visually near-neutral white and gray surfaces; remove the green tint from Quiet instrument's base planes.",
      "contrast": "Fine gray drawing details, darker labels, and a clear outside keyboard-focus outline.",
      "accentUse": "The inspected figures view relies mainly on value contrast; retain semantic status colors in ZAO.",
      "density": "Open breathing room around small precise figures and concise labels.",
      "radiusFamily": "Reference has rounded enclosures; Su keeps its chosen square actions and trial 2px passive corners.",
      "typeContrast": "Hierarchy separates headings, explanations, names, and readings; preserve ZAO's Geist roles.",
      "depth": "Thin linework makes layered geometry legible with restrained supporting surfaces.",
      "motion": "The Exploded figure describes pointer position as layer separation and selection; study cause-and-effect motion in future component detail."
    },
    "id": "ref-e968b3f6-5cd6-408d-a618-62a198d0f7f8",
    "createdAt": "2026-10-06T21:21:45.085Z",
    "updatedAt": "2026-10-06T21:21:45.085Z"
  }
]
