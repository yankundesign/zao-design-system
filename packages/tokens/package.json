{
  "name": "@zao/tokens",
  "version": "0.0.0",
  "description": "ZAO design tokens in the W3C DTCG format, with a resolver for the Su and Yu finishes in light and dark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/zao.css",
    "./json/*": "./dist/json/*.json",
    "./resolver": "./src/zao.resolver.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "palette": "node scripts/generate-palettes.ts",
    "build": "tz build && node scripts/export-json.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "culori": "^4.0.2",
    "vitest": "^5.0.2"
  }
}
